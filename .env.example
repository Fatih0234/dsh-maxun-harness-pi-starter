# Generated/imported locally. Never commit real values.
OPENCODE_API_KEY=
# Goal-1 Maxun one-shot generator uses the same OpenCode Go endpoint as an OpenAI-compatible LLM.
MAXUN_AGENT_LLM_PROVIDER=openai
MAXUN_AGENT_LLM_MODEL=deepseek-v4-flash
MAXUN_AGENT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
MAXUN_BASE_URL=http://127.0.0.1:8080/api
# Optional public origin for direct Goal 4 Socket.IO browser streams; defaults to the request origin.
MAXUN_BROWSER_STREAM_URL=
MAXUN_API_KEY=
FIXTURE_URL=http://127.0.0.1:4173/page1.html
DSH_TELEMETRY_DISABLED=1
DSH_PERMISSION_MODE=workspace-write
